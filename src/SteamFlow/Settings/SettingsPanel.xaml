<UserControl x:Class="SteamFlow.Settings.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="28,0,0,10" />
        </Style>

        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Section" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Color05B}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color03B}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="-8,18,24,14" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top"
                                              Content="{TemplateBinding Header}"
                                              Foreground="{TemplateBinding Foreground}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{DynamicResource ExpanderHeaderRightArrowStyle}" />
                                <Border x:Name="Body" BorderBrush="{DynamicResource Color03B}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="32,-4,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Sections" Margin="-2,0,-2,0">
        <Expander Header="{DynamicResource steamflow_settings_section_search}" Style="{StaticResource Section}" Expanded="OnSectionExpanded">
            <StackPanel Style="{StaticResource SectionBody}">
                <TextBlock Text="{DynamicResource steamflow_settings_blacklist_label}" />
                <TextBox Margin="0,6,0,4"
                         Text="{Binding BlacklistedAppIds, UpdateSourceTrigger=PropertyChanged}"
                         LostFocus="OnSettingChanged" />
                <TextBlock Style="{StaticResource Description}" Margin="0,0,0,14"
                           Text="{DynamicResource steamflow_settings_blacklist_description}" />

                <CheckBox IsChecked="{Binding HideHiddenGames}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_hide_hidden_games_label}" />
                <TextBlock Style="{StaticResource Description}" Text="{DynamicResource steamflow_settings_hide_hidden_games_description}" />

                <CheckBox IsChecked="{Binding SortLocalByRecent}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_sort_local_by_recent_label}" />
                <TextBlock Style="{StaticResource Description}" Text="{DynamicResource steamflow_settings_sort_local_by_recent_description}" />
            </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource steamflow_settings_section_details}" Style="{StaticResource Section}" Expanded="OnSectionExpanded">
            <StackPanel Style="{StaticResource SectionBody}">
                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowPlaytime}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_playtime_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowLastPlayed}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_last_played_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowAchievements}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_achievements_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowPlayerCount}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_player_count_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowPositiveReviews}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_positive_reviews_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowPrices}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_prices_label}" />
            </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource steamflow_settings_section_context_menu}" Style="{StaticResource Section}" Expanded="OnSectionExpanded"
                  BorderThickness="0">
            <StackPanel Style="{StaticResource SectionBody}">
                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowSteamDbContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_steamdb_label}" />

                <CheckBox IsChecked="{Binding ShowCsRinContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_csrin_label}" />
                <TextBlock Style="{StaticResource Description}" Text="{DynamicResource steamflow_settings_show_csrin_description}" />

                <CheckBox IsChecked="{Binding ShowProtonDbContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_protondb_label}" />
                <TextBlock Style="{StaticResource Description}" Text="{DynamicResource steamflow_settings_show_protondb_description}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowGuidesContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_guides_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowDiscussionsContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_discussions_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowScreenshotsContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_screenshots_label}" />

                <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowPropertiesContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_show_properties_label}" />

                <CheckBox IsChecked="{Binding EnableSmokeApiContextMenu}" Click="OnSettingChanged"
                          Content="{DynamicResource steamflow_settings_smokeapi_label}" />
                <TextBlock Style="{StaticResource Description}" Text="{DynamicResource steamflow_settings_smokeapi_description}" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
